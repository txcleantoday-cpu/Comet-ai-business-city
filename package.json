    "@abc/agents": "workspace:*",
    "@abc/integrations": "workspace:*",
    "@abc/workflows": "workspace:*"
  },
  "devDependencies": {
    "typescript": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
