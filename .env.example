# Core
DATABASE_URL=
APP_OWNER_TOKEN=
PUBLIC_BASE_URL=http://localhost:3000
WORKER_POLL_MS=1500

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2

# Zoho CRM (US defaults; override for other data centers)
ZOHO_API_BASE_URL=https://www.zohoapis.com/crm/v8
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_ACCESS_TOKEN=
ZOHO_REFRESH_TOKEN=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# Google Gmail + Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Etsy Open API v3
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=
ETSY_SHOP_ID=
ETSY_TAXONOMY_ID=
ETSY_DEFAULT_PRICE=9.99

# Retell
RETELL_API_KEY=
RETELL_FROM_NUMBER=
RETELL_AGENT_ID=

# Meta
META_GRAPH_VERSION=
META_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=

# Creator pipeline
CREATOR_AUTO_DERIVE=false
MAX_MEDIA_UPLOAD_MB=15

# Runnable local server only
ABC_PORT=8787
ABC_SQLITE_PATH=./runnable/data/ai-business-city.sqlite
SIMULATION_MODE=false

# Netlify free deployment tuning
WEB_WORKER_BATCH=4
PG_POOL_MAX=2
